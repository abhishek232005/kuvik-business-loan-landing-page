NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=kuvik_business_loan
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_CA_PATH=

JWT_SECRET=
DATA_ENCRYPTION_KEY=
PHONE_HASH_SECRET=
OTP_HASH_SECRET=
CONSENT_VERSION=2026-10-business-v1

# For local development only. Test OTP is never enabled in production.
SMS_TEST_MODE=true
SMS_PROVIDER=
SMS_API_URL=https://control.msg91.com/api/v5/otp
SMS_API_TOKEN=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# Optional CRM integration; when blank, enquiries remain in the app database.
CRM_DB_HOST=localhost
CRM_DB_PORT=3306
CRM_DB_NAME=kuvik_crm
CRM_DB_USER=
CRM_DB_PASSWORD=
CRM_DB_CONNECTION_LIMIT=5
CRM_DB_SSL=false
CRM_DB_SSL_CA_PATH=

TRUST_PROXY_HOPS=0
LOG_LEVEL=info
